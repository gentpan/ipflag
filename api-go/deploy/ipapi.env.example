# Copy to /etc/ipflag-api/ipapi.env on the server and fill in the keys.
# Keep this file outside the repository; it is read only by the API service.
#
#   install -d -m 0750 -o root -g www-data /etc/ipflag-api
#   install -m 0640 -o root -g www-data ipapi.env /etc/ipflag-api/ipapi.env
#
# Sources are tried in order: ip2location.io, then cnip.io, then ipapi.is.
# A source with no key here is skipped; cnip.io needs none.
# Keys must never reach the browser extension: the extension talks to this
# API, and this API talks to the providers.
IP2LOCATION_KEY=
IPAPI_IS_KEY=
