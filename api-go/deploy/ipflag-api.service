[Unit]
Description=IP Flag geolocation API (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ipflag-api/current
Environment=PORT=4320
Environment=HOST=127.0.0.1
Environment=RATE_LIMIT=120
# The only geolocation source. The key lives in a root-owned file that is
# never committed; the service refuses to start without it.
EnvironmentFile=-/etc/ipflag-api/ipapi.env
# ipapi.is publishes no quota headers, so the budget is enforced locally.
# It also rate-limits bursts per source IP, hence the concurrency cap.
Environment=IPAPI_IS_DAILY_LIMIT=20000
Environment=IPAPI_IS_MAX_INFLIGHT=12
Environment=IPAPI_IS_TIMEOUT=4s
Environment=GEO_CACHE_TTL=720h
Environment=GEO_CACHE_PATH=/var/lib/ipflag-api/geo-cache.db
Environment=GEO_CACHE_MAX=500000
# Creates and owns /var/lib/ipflag-api so the cache survives restarts.
StateDirectory=ipflag-api
StateDirectoryMode=0750
ExecStart=/opt/ipflag-api/current/ipflag-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
