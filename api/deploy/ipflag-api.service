[Unit]
Description=IP Flag geolocation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ipflag-api/current
Environment=NODE_ENV=production
Environment=PORT=4320
Environment=HOST=127.0.0.1
Environment=DBIP_MMDB_PATH=/opt/ipflag-api/current/data/dbip-city-lite.mmdb
Environment=RATE_LIMIT=120
ExecStart=/usr/bin/node /opt/ipflag-api/current/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
